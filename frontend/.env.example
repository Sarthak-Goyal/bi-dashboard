# Only needed if the API is on a different origin than the frontend (not the case with
# `npm run dev`, which proxies /api, nor with the single-container Docker image).
# VITE_API_URL=http://localhost:8000

# Sent as X-API-Key on write requests (the "Refresh All" button). NOTE: anything in a
# browser bundle is public — this demonstrates the header pattern, not real secrecy.
# VITE_API_KEY=
