# ── NSW BI Dashboard — backend configuration ─────────────────────────────
# Copy to .env  (cp .env.example .env). Every value is optional.

ENVIRONMENT=development

# Database. Leave empty for SQLite (backend/data/dashboard.db).
# For Postgres:  postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Protects POST /api/pipeline/refresh. Leave empty for open access in local dev.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Comma-separated list of allowed browser origins (only needed if the frontend
# is served from a different origin than the API).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Pipelines
RUN_PIPELINES_ON_STARTUP=background   # background | sync | off
ENABLE_SCHEDULER=true
FULL_REFRESH_HOURS=6
LABOUR_REFRESH_HOURS=1
CACHE_TTL_SECONDS=60

# Optional overrides if the data publishers move their datasets
# CRIME_RESOURCE_ID=
# ABS_BASE_URL=https://api.data.abs.gov.au/data
